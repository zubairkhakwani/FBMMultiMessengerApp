@page "/Default-Messages"
@layout MainLayout

@attribute [Authorize(Policy = "ValidSubscription")]

<MudPaper Elevation="0" Style="display: flex; flex-direction: column;" Height="100%" Width="100%">
    <div class="neeleez-page-header">
        <h3 class="page-title">Default Message Management</h3>
        <div class="neeleez-page-header--actions">
            <button @onclick="AddDefaultMessage" class="add-account-btn">+ Add Default Message</button>
        </div>
    </div>

    <MudTable ServerData="ServerReload" Dense="true" Hover="true" @ref="table">
        <HeaderContent>
            <MudTh>Message</MudTh>
            <MudTh>Used On</MudTh>
            <MudTh>CreatedAt</MudTh>
            <MudTh>Actions</MudTh>

        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Message">@context.Message</MudTd>
            @{
                var count = context.Accounts.Count();
                var accountColoumnText = $"{count} Account{(count > 1 ? "s" :" ")}";
            }
            <MudTd DataLabel="Total accounts that has this message">@accountColoumnText</MudTd>
            <MudTd DataLabel="Account Created At">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</MudTd>
            <MudTd DataLabel="Actions" Title="Actions" Class="col-ignore stick-action-column">

                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Dense="true" AnchorOrigin="Origin.BottomLeft" Style="align-self: auto;">
                        <MudPaper Style="min-width: 200px; max-width: 235px; box-shadow:none !important; padding:0 8px;">
                            <MudButton OnClick="@(e => EditDefaultMessageAsync(context.Id, context.Message, context.Accounts))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                                       Color="Color.Success"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Edit</span>
                            </MudButton>
                        </MudPaper>
                    </MudMenu>
                </MudButtonGroup>




            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No matching records found</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
    <button @onclick="AddDefaultMessage" class="add-new-account-container">
        <i class="fa-solid fa-plus"></i>
    </button>
</MudPaper>
