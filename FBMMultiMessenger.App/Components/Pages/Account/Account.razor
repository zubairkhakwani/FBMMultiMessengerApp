@page "/Account"
@layout MainLayout

@attribute [Authorize(Policy = "ValidSubscription")]

<MudPaper Elevation="0" Style="display: flex; flex-direction: column;" Height="100%" Width="100%">
    <div class="neeleez-page-header">
        <h3 class="page-title">Account Management</h3>
        <div class="account-header--actions">
            <button @onclick="AddNewAccountAsync" class="account-header--btn">+ Add Account</button>
            <InputFile type="file" id="fileInput" style="display: none;" onchange="HandleImportFile" />
            <label class="account-header--btn" for="fileInput" title="Attach files">Import File </label>

        </div>
    </div>

    <button @onclick="HandleMultipleRemoval" class="btn-delete">
        🗑️ Delete Selected
    </button>
    <MudTable ServerData="ServerReload" Dense="true" Hover="true" @ref="table" MultiSelection=true SelectedItems="_selectedAccounts">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Cookie</MudTh>
            <MudTh>CreatedAt</MudTh>
            <MudTh>Actions</MudTh>

        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Account Name">@context.Name</MudTd>
            <MudTd title="@context.Cookie" Style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" DataLabel="Account Cookie">@context.Cookie</MudTd>
            <MudTd DataLabel="Account Created At">@context.CreatedAt</MudTd>
            <MudTd DataLabel="Actions" Title="Actions" Class="col-ignore stick-action-column">

                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Dense="true" AnchorOrigin="Origin.BottomLeft" Style="align-self: auto;">
                        <MudPaper Style="min-width: 200px; max-width: 235px; box-shadow:none !important; padding:0 8px;">

                            <MudButton OnClick="@(e => OpenBrowser(context.Id))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInBrowser"
                                       Color="Color.Success"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Open Browser</span>
                            </MudButton>
                            <MudButton OnClick="@(e => EditAccountAsync(context.Id, context.Name, context.Cookie))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                                       Color="Color.Success"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Edit</span>
                            </MudButton>

                            <MudButton OnClick="@(e => RemoveAccountAsync(new List<int> { context.Id }))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PersonRemove"
                                       Color="Color.Error"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Delete</span>
                            </MudButton>




                        </MudPaper>
                    </MudMenu>
                </MudButtonGroup>




            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No account found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    <button @onclick="AddNewAccountAsync" class="add-new-account-container">
        <i class="fa-solid fa-plus"></i>
    </button>
</MudPaper>


