@page "/Account"
@layout MainLayout

@* @attribute [Authorize(Policy = "ValidSubscription")] *@

<MudPaper Elevation="0" Style="display: flex; flex-direction: column;" Height="100%" Width="100%">

    <div class="accounts-toolbar">

        <!-- Header -->
        <div class="main-toolbar">
            <h2 style="color: #333; margin: 0;">Accounts Management</h2>
            <div class="toolbar-left">
                <button @onclick="AddNewAccountAsync" class="btn btn-primary btn-hide-mobile">
                    ➕ Add Account
                </button>
                <InputFile type="file" id="fileInput" style="display: none;" onchange="HandleImportFile" />
                <label class="btn btn-secondary" for="fileInput" title="Attach files">📁 Import File</label>
            </div>
        </div>

        <!-- FILTER BAR: Search & Filters -->
        <div class="filter-bar">
            <div class="filter-left">
                <div class="search-group">
                    <input type="text"
                           @onkeypress="HandleFilterKeyPressAsync"
                           @bind-value="Keyword"
                           class="search-input"
                           id="searchInput"
                           placeholder="Search accounts...">
                    <button @onclick="HandleFilterClickAsync" class="btn btn-primary btn-fullwidth">
                        🔍 Filter
                    </button>
                </div>

            </div>

            <div class="filter-right">
                @if (selectedAccounts.Any())
                {
                    <span class="selection-badge" id="selectionBadge">
                        <span id="selectedCount">@selectedAccounts.Count</span> selected
                    </span>
                }

                <button @onclick="HandleMultipleRemoval" class="btn btn-danger btn-fullwidth">
                    🗑️ Delete Selected
                </button>

            </div>
        </div>

        <!-- Summary  -->
        <div class="summary-bar">
            <button class="btn btn-primary custom-disabled">
                Total Accounts:<b> @TotalAccounts </b>
            </button>
            <button class="btn btn-success custom-disabled">
               Connected Accounts:<b> @ConnectedAccounts</b>
            </button>
            <button class="btn btn-danger custom-disabled">
                Not Connected Accounts:<b> @NotConnectedAccounts</b>
                </button>
        </div>
    </div>

    <MudTable ServerData="ServerReload" Dense="true" Hover="true" @ref="table" MultiSelection=true @bind-SelectedItems="selectedAccounts">

        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Cookie</MudTh>
            <MudTh>Ip Port</MudTh>
            <MudTh>Connection Status</MudTh>
            <MudTh>Account Status</MudTh>
            <MudTh>Created At</MudTh>
            <MudTh>Actions</MudTh>

        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd title="@context.Cookie" Style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" DataLabel="Cookie">@context.Cookie</MudTd>
            @{
                string ipPort = context.Proxy is null ? "-" : context.Proxy.Name;
                int? proxyId = context.Proxy is null ? null : context.Proxy.Id;
            }

            <MudTd title="@ipPort" Style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" DataLabel="Ip Port">@ipPort</MudTd>

            <MudTd DataLabel="Connection Status">
                <span class="@GetConnectionStatusBadgeClass(context.ConnectionStatus)">
                    @context.ConnectionStatus
                </span>
            </MudTd>
            <MudTd DataLabel="Account Status">
                <span class="@GetAuthStatusBadgeClass(context.AuthStatus)">
                    @context.AuthStatus
                </span>
            </MudTd>

            <MudTd DataLabel="Created At">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh: mm tt")</MudTd>
            <MudTd DataLabel="Actions" Title="Actions" Class="col-ignore stick-action-column">

                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Dense="true" AnchorOrigin="Origin.BottomLeft" Style="align-self: auto;">
                        <MudPaper Style="min-width: 200px; max-width: 235px; box-shadow:none !important; padding:0 8px;">

                            <MudButton OnClick="@(e => ConnectAccount(context.Id))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInBrowser"
                                       Color="Color.Success"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Connect</span>
                            </MudButton>
                            <MudButton OnClick="@(e => EditAccountAsync(context.Id, context.Name, context.Cookie, proxyId))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                                       Color="Color.Success"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Edit</span>
                            </MudButton>

                            <MudButton OnClick="@(e => RemoveAccountAsync(new List<int> { context.Id }))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PersonRemove"
                                       Color="Color.Error"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Delete</span>
                            </MudButton>
                        </MudPaper>
                    </MudMenu>
                </MudButtonGroup>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No account found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    <button @onclick="AddNewAccountAsync" class="floating-add-button">
        <i class="fa-solid fa-plus"></i>
    </button>
</MudPaper>


