@page "/Pricing"
@using FBMMultiMessenger.Contracts.Enums
<div class="parent-pricing-container">
    <div class="pricing-container">

        <div class="action-container">
            <button class="back-button" @onclick="HandleBackToDasboard">
                ← Back to Dashboard
            </button>

            <button class="mobile-logout-btn" @onclick="HandleLogout">
                <div class="mobile-menu-icon"> <i class="fa fa-sign-out-alt"></i></div>
                <span>Logout</span>
            </button>
        </div>

        <div class="header">
            <h1>Our Packages</h1>
            <p>Choose your plan and get started today</p>
            <p class="punchline">"Growth isn't expensive, staying small is"</p>
        </div>

        <!-- Discount Section START -->
        <div class="custom-pricing-card">
            <h2 class="custom-card-title">💰 Pricing Calculator</h2>

            <!-- Billing Period Section -->
            <div class="billing-section">

                <div class="billing-tabs">

                    @if (PricingTierAvailability.IsMonthlyAvailable)
                    {
                        <button class="billing-tab  @(CurrentBillingCycle == BillingCylce.Monthly ? "active" : "")" @onclick='() => HandleBillingCyleChanged(BillingCylce.Monthly)'>
                            Monthly
                        </button>
                    }

                    @if (PricingTierAvailability.IsSemiAnnualAvailable)
                    {
                        <button class="billing-tab @(CurrentBillingCycle == BillingCylce.SemiAnnual ? "active" : "")" @onclick='() => HandleBillingCyleChanged(BillingCylce.SemiAnnual)'>
                            Semi-Annual
                            <span class="save-tag">💰 Discount</span>
                        </button>
                    }

                    @if (PricingTierAvailability.IsAnnualAvailable)
                    {
                        <button class="billing-tab @(CurrentBillingCycle == BillingCylce.Annual ? "active" : "")" @onclick='() => HandleBillingCyleChanged(BillingCylce.Annual)'>
                            Annual
                            <span class="save-tag hot">🔥 Discount</span>
                        </button>
                    }
                </div>
            </div>


            <!-- Volume Discounts Section -->
            <div class="pricing-tiers">
                <h3>💡 Volume Discounts Available</h3>
                @if (IsPricingLoading)
                {
                    <PricingLoadingSkelton></PricingLoadingSkelton>
                }

                else
                {
                    <div class="tier-list">
                        @for (int i = 0; i < DisplayedPricings.Count; i++)
                        {
                            var pricing = DisplayedPricings[i];
                            var id = pricing.Id;
                            var uptoAccounts = pricing.UptoAccounts;
                            var orignalPrice = pricing.OrignalPrice;
                            var discountedPrice = pricing.DiscountedPrice;
                            var active = pricing.IsActive ? "active" : "";

                            <div class="tier-item @active" @onclick="() => HandleTierSelection(id)">
                                <span class="tier-range">
                                    Upto @uptoAccounts Accounts
                                </span>
                                <div class="tier-pricing">
                                    @if (orignalPrice == discountedPrice)
                                    {
                                        <span class="tier-price">PKR @discountedPrice.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="tier-original-price">PKR @orignalPrice.ToString("N0")</span>
                                        <span class="tier-price">PKR @discountedPrice.ToString("N0")</span>
                                    }

                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Price Display -->
            <div class="pricing-display">
                <div class="price-item">
                    <div class="label">Total Cost @CurrentBillingCycle.ToString()</div>
                    <div class="value">PKR @TotalCost.ToString("N0")</div>
                    <div class="savings-badge">You save PKR @Savings.ToString("N0")! </div>
                </div>
            </div>

            <button class="purchase-btn" id="purchaseBtn" disabled="@(!CanSubmitPayment())">
                Proceed to Purchase
            </button>

        </div>
        <!-- Discount Section END -->
        <!-- Banking Details Section -->
        <div class="custom-pricing-card hidden scroll-to-section" id="bankingSection">
            <h2 class="custom-card-title"><span class="icon">🏦</span> Banking Details</h2>
            <p style="margin-bottom: 20px; color: #666;">Please use <strong>ONE</strong> of the following details to complete your payment</p>

            <!-- Payment Amount Banner -->
            <div class="payment-amount-banner">
                <div class="amount-label">Amount to Pay</div>
                <div class="amount-value">PKR @TotalCost.ToString("N0")</div>
                <div class="amount-note">For @SelectedTier?.UptoAccounts account(s) • @CurrentBillingCycle.ToString() billing</div>
            </div>

            <div class="banking-details">
                @foreach (var account in AccountDetails)
                {
                    var bankName = account.BankName;
                    var bankTitle = account.Title;
                    var accountNo = account.AccountNo;
                    var iban = account.IBAN;

                    <div class="bank-info">
                        @if (!string.IsNullOrWhiteSpace(bankName))
                        {
                            <div class="info-row">
                                <span class="info-label">Bank Name:</span>
                                <span class="info-value">@bankName</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(bankTitle))
                        {
                            <div class="info-row">
                                <span class="info-label">Account Title:</span>
                                <span class="info-value">@bankTitle</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(accountNo))
                        {
                            <div @onclick="() => HandleCopyToClipboardAsync(accountNo)" class="info-row">
                                <span class="info-label">Account No:</span>
                                <span class="info-value">
                                    @accountNo
                                    <span class="copy-icon" title="Copy to clipboard">📋</span>
                                </span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(iban))
                        {
                            <div @onclick="() => HandleCopyToClipboardAsync(iban, isCopyIBAN: true)" class="info-row">
                                <span class="info-label">IBAN:</span>
                                <span class="info-value">
                                    @iban
                                    <span class="copy-icon" title="Copy to clipboard">📋</span>
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Important Instructions -->
            <div class="payment-instructions">
                <h4>⚠️ Important Instructions</h4>
                <ul>
                    <li>Transfer exactly <strong>PKR @TotalCost.ToString("N0")</strong> to avoid rejection</li>
                    <li>Use the account number or IBAN provided above</li>
                    <li>Keep your payment receipt/screenshot for verification</li>
                    <li>Upload your payment proof in the section below</li>
                </ul>
            </div>
        </div>

        <!-- Upload Payment Proof Section -->
        <div class="custom-pricing-card hidden scroll-to-section" id="uploadSection">
            <h2 class="custom-card-title"><span class="icon">📤</span> Submit Payment Proof</h2>
            <p style="margin-bottom: 20px; color: #666;">Upload your payment receipt for verification</p>
            <EditForm Model="@RequestModel" class="upload-form" id="uploadForm" OnValidSubmit="HandlePaymentProofSubmitAsync">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label for="paymentProof">Upload Payment Receipt *</label>
                    <div class="file-input-wrapper">
                        <label for="paymentProof" class="file-input-label">
                            <span>Click to upload receipt (JPG, PNG, PDF)</span>
                        </label>
                        <InputFile multiple type="file" style="display: none;" id="paymentProof" onchange="HandlePaymentProofChangeAsync" />
                        <ValidationMessage For="@(() => RequestModel.PaymentImages)" class="validation-message" />
                    </div>

                    @if (PreviewSelectedImages.Any())
                    {
                        <div class="preview-container" id="previewContainer">
                            <span class="preview-label">Payment Receipt Preview:</span>
                            <div class="preview-image-container">
                                @foreach (var url in PreviewSelectedImages)
                                {
                                    <img class="preview-media" id="previewImage" src="@url" alt="Payment receipt preview">
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label for="notes">Additional Notes (Optional)</label>
                    <textarea @bind="RequestModel.Note" id="notes" rows="4" placeholder="Any additional information..."></textarea>
                </div>

                @if (IsSubmitting)
                {
                    <button type="submit" class="submit-btn" disabled>
                        <div class="loader"></div>
                    </button>
                }
                else
                {
                    <button type="submit" class="submit-btn">
                        SUBMIT FOR APPROVAL
                    </button>
                }

                @if (!string.IsNullOrWhiteSpace(ResponseMessage))
                {
                    var responseClass = IsSuccess ? "success-message" : "error-message";
                    <div class="@responseClass">
                        @ResponseMessage
                    </div>
                }
            </EditForm>
        </div>
    </div>
</div>


<script src="/Components/Pages/Pricing/Pricing.razor.js"></script>


