@page "/Pricing"
@using FBMMultiMessenger.Contracts.Enums
<div class="parent-pricing-container">
    <div class="pricing-container">
        <a class="back-button" href="/account">
            ← Back to Dashboard
        </a>
        <div class="header">
            <h1>Our Packages</h1>
            <p>Choose your plan and get started today</p>
            <p class="punchline">"Growth isn't expensive, staying small is"</p>
        </div>

        <!-- Discount Section START -->
        <div class="custom-pricing-card">
            <h2 class="custom-card-title">💰 Pricing Calculator</h2>

            <!-- Billing Period Section -->
            <div class="billing-section">
                <div class="billing-tabs">
                    <button class="billing-tab @(CurrentBillingCycle == BillingCylce.Monthly ? "active" : "")" @onclick='() => HandleBillingCyleChanged(BillingCylce.Monthly)'>
                        Monthly
                    </button>
                    <button class="billing-tab @(CurrentBillingCycle == BillingCylce.SemiAnnual ? "active" : "")" @onclick='() => HandleBillingCyleChanged(BillingCylce.SemiAnnual)'>
                        Semi-Annual
                        @*  <span class="save-tag">⚡ Save 10%</span> *@
                    </button>
                    <button class="billing-tab @(CurrentBillingCycle == BillingCylce.Annual ? "active" : "")" @onclick='() => HandleBillingCyleChanged(BillingCylce.Annual)'>
                        Annual
                        @*   <span class="save-tag">🔥 Save 20%</span> *@
                    </button>
                </div>
            </div>


            <!-- Volume Discounts Section -->
            <div class="pricing-tiers">
                <h3>💡 Volume Discounts Available</h3>
                <div class="tier-list" id="tierList">

                    @for (int i = 0; i < DisplayedPricings.Count; i++)
                    {
                        var pricing = DisplayedPricings[i];
                        var minAccounts = pricing.MinAccounts;
                        var maxAccounts = pricing.MaxAccounts;
                        var perAccountPrice = pricing.PricePerAccount;
                        var active = pricing.IsActive ? "active" : "";
                        <div class="tier-item @active">
                            <span class="tier-range">@minAccounts-@maxAccounts accounts</span>
                            <span class="tier-price">PKR @perAccountPrice / account</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Account Input -->
            <div class="input-group">
                <label for="accounts">Number of Accounts</label>
                <input type="number" @bind-value="AccountsInput" @bind-value:event="oninput" placeholder="Enter number of accounts" min="1">
            </div>
            <!-- Price Display -->
            <div class="pricing-display">
                <div class="price-item">
                    <div class="label">Price Per Account</div>
                    <div class="value" id="pricePerAccount1">PKR @PricePerAccount</div>
                </div>
                <div class="price-item">
                    <div class="label">Total Accounts</div>
                    <div class="value" id="totalAccounts1">@AccountsInput</div>
                </div>
                <div class="price-item">
                    <div class="label" id="costLabel1">Total Cost</div>
                    <div class="value" id="totalCost1">PKR @TotalCost</div>
                </div>
            </div>

            <button class="purchase-btn" id="purchaseBtn">Proceed to Purchase</button>
        </div>
        <!-- Discount Section END -->
        <!-- Banking Details Section -->
        <div class="custom-pricing-card hidden scroll-to-section" id="bankingSection">
            <h2 class="custom-card-title"><span class="icon">🏦</span> Banking Details</h2>
            <p style="margin-bottom: 20px; color: #666;">Please use the following details to complete your payment</p>
            <div class="banking-details">
                <div class="bank-info">
                    <div class="info-row">
                        <span class="info-label">Bank Name:</span>
                        <span class="info-value">ABC Bank</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Account Title:</span>
                        <span class="info-value">Your Company Name</span>
                    </div>
                    <div @onclick="() => HandleCopyToClipboardAsync()" class="info-row">
                        <span class="info-label">Account No:</span>
                        <span class="info-value">
                            @AccountNo
                            <span class="copy-icon" title="Copy to clipboard">📋</span>
                        </span>
                    </div>
                    <div @onclick="() => HandleCopyToClipboardAsync(isCopyIBAN: true)" class="info-row">
                        <span class="info-label">IBAN:</span>
                        <span class="info-value">
                            @IBAN
                            <span class="copy-icon" title="Copy to clipboard">📋</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upload Payment Proof Section -->
        <div class="custom-pricing-card hidden scroll-to-section" id="uploadSection">
            <h2 class="custom-card-title"><span class="icon">📤</span> Submit Payment Proof</h2>
            <p style="margin-bottom: 20px; color: #666;">Upload your payment receipt for verification</p>
            <EditForm Model="@RequestModel" class="upload-form" id="uploadForm" OnValidSubmit="HandlePaymentProofSubmitAsync">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label for="paymentProof">Upload Payment Receipt *</label>
                    <div class="file-input-wrapper">
                        <label for="paymentProof" class="file-input-label">
                            <span>Click to upload receipt (JPG, PNG, PDF)</span>
                        </label>
                        <InputFile multiple type="file" style="display: none;" id="paymentProof" onchange="HandlePaymentProofChangeAsync" />
                        <ValidationMessage For="@(() => RequestModel.PaymentImages)" class="validation-message" />
                    </div>

                    @if (PreviewSelectedImages.Any())
                    {
                        <div class="preview-container" id="previewContainer">
                            <span class="preview-label">Payment Receipt Preview:</span>
                            <div class="preview-image-container">
                                @foreach (var url in PreviewSelectedImages)
                                {
                                    <img class="preview-media" id="previewImage" src="@url" alt="Payment receipt preview">
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label for="accountsPurchased">Accounts Purchased</label>
                    <input type="number" id="accountsPurchased" @bind-value="AccountsInput" disabled>
                </div>
                <div class="form-group">
                    <label for="accountsPurchased">Purchased Price</label>
                    <input type="number" id="purchasedPrice" @bind-value="TotalCost" disabled>
                </div>

                <div class="form-group">
                    <label for="notes">Additional Notes (Optional)</label>
                    <textarea @bind="RequestModel.Note" id="notes" rows="4" placeholder="Any additional information..."></textarea>
                </div>

                @if (IsSubmitting)
                {
                    <button type="submit" class="submit-btn" disabled>
                        <div class="loader"></div>
                    </button>
                }
                else
                {
                    <button type="submit" class="submit-btn">
                        SUBMIT FOR APPROVAL
                    </button>
                }

                @if (!string.IsNullOrWhiteSpace(ResponseMessage))
                {
                    var responseClass = IsSuccess ? "success-message" : "error-message";
                    <div class="@responseClass">
                        @ResponseMessage
                    </div>
                }
            </EditForm>
        </div>
    </div>
</div>


<script src="/Components/Pages/Pricing/Pricing.razor.js"></script>


