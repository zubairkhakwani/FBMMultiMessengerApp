@page "/Proxy"
@layout MainLayout


<MudPaper Elevation="0" Style="display: flex; flex-direction: column;" Height="100%" Width="100%">

    <div style="display:flex; justify-content:space-between; margin-bottom:1rem;">
        <h2 style="color: #333; margin: 0;">Proxy Management</h2>
        <div>
            <button @onclick="AddNewProxyAsync" class="btn btn-primary">
                ➕ Add Proxy
            </button>
        </div>
    </div>


    <MudTable ServerData="ServerReload" Dense="true" Hover="true" @ref="table" >
        <HeaderContent>
            <MudTh>Ip:Port </MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Password</MudTh>
            <MudTh>Created At</MudTh>
            <MudTh>Actions</MudTh>

        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Ip port">@context.Ip_Port</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Password">@context.Password</MudTd>
            <MudTd DataLabel="Created At">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh: mm tt")</MudTd>
            <MudTd DataLabel="Actions" Title="Actions" Class="col-ignore stick-action-column">

                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Dense="true" AnchorOrigin="Origin.BottomLeft" Style="align-self: auto;">
                        <MudPaper Style="min-width: 200px; max-width: 235px; box-shadow:none !important; padding:0 8px;">

                            <MudButton OnClick="@(e => EditProxyAsync(context.Id,context.Ip_Port ,context.Name, context.Password))"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                                       Color="Color.Success"
                                       Variant="Variant.Text"
                                       Class="px-3 py-1 mb-1"
                                       FullWidth="true"
                                       Style="justify-content: flex-start; text-transform: none; min-height: 32px;">
                                <span style="margin-left: 8px;">Edit</span>
                            </MudButton>
                        </MudPaper>
                    </MudMenu>
                </MudButtonGroup>




            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No proxies found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    @* <button @onclick="AddNewAccountAsync" class="add-new-account-container">
        <i class="fa-solid fa-plus"></i>
    </button> *@
</MudPaper>


