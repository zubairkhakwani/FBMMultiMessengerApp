<!-- Chat Menu -->
<div class="chat-menu-container">

    <!-- Chat Menu Header -->
    <div class="chat-menu-header">

        <button class="chat-menu-title-row" @onclick="CloseMenu">
            <span class="chat-menu-back-btn">
                <i class="fa-sharp fa-solid fa-arrow-left"></i>
            </span>
            <div class="chat-menu-title">Chat Menu</div> 
        </button>
    </div>

    <!-- Chat Menu Divider -->
    <div class="chat-menu-divider"></div>

    <!-- Chat Menu Actions -->
    <div class="chat-menu-actions">

        <div class="chat-menu-section-title">Actions</div>

        <div class="chat-menu-item" @onclick="ViewUserProfile">
            <div class="chat-menu-icon"><i class="fa fa-id-badge"></i></div>
            <span>View @(string.IsNullOrWhiteSpace(ProfileName) ? "Profile" : $"{ProfileName}'s Profile")</span>
        </div>
    </div>

</div>
