<div class="password-requirements">
                    <h4>Password Requirements:</h4>
                    <ul class="requirements-list" id="requirements">
                        <li class="@ReqlengthClass" id="req-length">At least 8 characters</li>
                        <li class="@ReqUppercaseClass" id="req-uppercase">One uppercase letter</li>
                        <li class="@ReqLowercaseClass" id="req-lowercase">One lowercase letter</li>
                        <li class="@ReqNumberClass" id="req-number">One number</li>
                        <li class="@ReqSpecialClass" id="req-special">One special character (@@$!%*?&)</li>
                    </ul>
</div>