@page "/forgot-password"
@layout EmptyLayout

<div class="page-container">
    <!-- STEP 1: Request Password Reset -->
    @if (!IsEmailSend)
    {
         <div class="step-container">
        <div class="step-header">
            <div class="step-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1>Forgot Password?</h1>
            <p>No worries, we'll send you reset instructions</p>
            <div class="step-indicator">Step 1 of 3</div>
        </div>
        <div class="step-content">
            <EditForm Model="ForgotPasswordModel" Enhance="true" OnValidSubmit="OnValidEmailSubmit">
                  <DataAnnotationsValidator />

                <div class="form-group">
                    <InputText @bind-Value="ForgotPasswordModel.Email"
                               type="email"
                               class="input"
                               placeholder="Enter your email address"
                               required/>
                    <ValidationMessage For="@(() => ForgotPasswordModel.Email)"
                                       class="validation-message" />
                </div>

                @if(IsEmailSending)
                {
                    <button type="submit" class="submit-button" disabled>
                     <div class="loader"></div>
                    </button>
                }
                else
                {
                    <button type="submit" class="submit-button">
                     <i class="fas fa-paper-plane"></i>
                       Send Code
                    </button>
                }
               
            </EditForm>
            <div class="back-to-login">
                <a href="/login">
                    <i class="fas fa-arrow-left"></i>
                    Back to Login
                </a>
            </div>
        </div>
        </div>
    }

    else if(IsEmailSend)
    {
       @*  STEP 2: Validate Otp *@
       <OtpValidator 
           EmailSentTo="@EmailSentTo"
           OtpSuccessMessage="@OtpSuccessMessage"
           OtpErrorMessage="@OtpErrorMessage"
           TotalSteps="3"
           CurrentStep="2"
           ReturnUrl="/Login"
           ReturnTo="Login"
       ></OtpValidator>
    }
</div>
  
    

   

 