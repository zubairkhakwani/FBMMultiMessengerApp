<div class="mobile-nav">
    <a class="icon-container" data-href="/Account">
        <div class="custom_nav-item">
            <i class="fa-solid fa-store"></i>
        </div>
    </a>

    <a class="icon-container " data-href="/Chat">
        <div class="custom_nav-item">
            <i class="fa fa-comments"> </i>
        </div>
    </a>

    <a class="icon-container" data-href="/mobile-sidebar">
        <div class="custom_nav-item">
            <div class="hamburger">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar half-size"></span>
            </div>
        </div>
    </a>
</div>

<script>
     (function () {
      let currentPath = window.location.pathname;
      let iconContainers = document.querySelectorAll(".icon-container");

      if (currentPath === "/" || currentPath === "") {
        currentPath = "/Chat";
    }
      iconContainers.forEach(function(container){
          container.addEventListener("click", function(e){
              e.preventDefault();
              let targetPath = container.getAttribute("data-href");
              if(targetPath != currentPath){
              window.location.href = targetPath;
              }
          });
      });

    let anchor = document.querySelector(`a[data-href="${currentPath}"]`);

      // let anchor = document.querySelector(`a[href="${currentPath}" i]`); here "i" is for case insensitive match
      if(anchor){
          let navItem = anchor.querySelector(".custom_nav-item");
          navItem?.classList.add("active");
      }

    })();
</script>
