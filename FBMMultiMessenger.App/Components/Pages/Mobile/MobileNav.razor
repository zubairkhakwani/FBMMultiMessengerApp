@using FBMMultiMessenger.Services.IServices
<div class="mobile-nav">
    <div class="icon-container" @onclick='() => NavigateTo("/Account")'>
        <div class="custom_nav-item @(IsActive("/Account") ? "active" : "")">
            <i class="fa-solid fa-store"></i>
        </div>
    </div>

    <div class="icon-container" @onclick='() => NavigateTo("/Chat")'>
        <div class="custom_nav-item @(IsActive("/Chat") ? "active" : "")">
            <i class="fa fa-comments"> </i>
        </div>
    </div>

    <div class="icon-container" @onclick='() => NavigateTo("/mobile-sidebar")'>
        <div class="custom_nav-item @(IsActive("/mobile-sidebar") ? "active" : "")">
            <div class="hamburger @(VersionHelper.IsUpdateAvailable ? "shimmer" : "") ">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar half-size"></span>
            </div>
        </div>
    </div>
</div>



