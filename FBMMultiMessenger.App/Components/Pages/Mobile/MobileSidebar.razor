@page "/mobile-sidebar"
@using FBMMultiMessenger.Services.IServices
@attribute [Authorize]


<!-- Mobile Sidebar -->
<div class="mobile-sidebar">
    <!-- Mobile Menu Header -->
    <div class="mobile-menu-header">
        <a href="/account" class="mobile-menu-title-row">
            <span class="mobile-close-btn"><i class="fa-sharp fa-solid fa-arrow-left"></i></span>
            <div class="mobile-menu-title">Menu</div>
        </a>
        <div class="mobile-user-profile">
            <div class="mobile-user-icon">@ShortName</div>
            <div class="mobile-user-name">@FullName</div>
        </div>
    </div>

    <!-- Mobile Divider -->
    <div class="mobile-divider"></div>

    <!-- Mobile Actions Section -->
    <div class="mobile-actions-section">
        <div class="mobile-section-title">Actions</div>

        <NavLink href="/account" class="mobile-menu-item">
            <div class="mobile-menu-icon"><i class="fa fa-id-badge"></i></div>
            <span>Accounts</span>
        </NavLink>

        <NavLink href="/Proxy"  class="mobile-menu-item">
             <div class="mobile-menu-icon">
                 <i class="fa fa-shield"></i>
             </div> 
              <span>Proxy</span>
         </NavLink>

        <NavLink href="/chat" class="mobile-menu-item">
            <div class="mobile-menu-icon">
                <i class="fa fa-comments"></i>
            </div>
            <span>Chats</span>
        </NavLink>

        <NavLink href="/Default-Messages" class="mobile-menu-item">
            <div class="mobile-menu-icon">
                <i class="fa fa-comment"></i>
            </div>
            <span>Default Messages</span>
        </NavLink>

        <NavLink href="/Profile" class="mobile-menu-item">
            <div class="mobile-menu-icon">
                <i class="fas fa-cog"></i>
            </div>
            <span>Profile</span>
        </NavLink>
    </div>

    <!-- Mobile Logout Button -->
    <button class="mobile-logout-btn" @onclick="Logout">
        <div class="mobile-menu-icon"> <i class="fa fa-sign-out-alt"></i></div>
        <span>Logout</span>
    </button>
</div>
