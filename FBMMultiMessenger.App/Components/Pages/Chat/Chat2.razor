@page "/"
@page "/Chat"

@layout EmptyLayout


@attribute [Authorize(Policy = "ValidSubscription")]

@{
    var mobileView = PlatformHelper.IsMobilePlatform ? "" : "messenger-container";
}


<div class="@mobileView">
    <!-- Sidebar -->
    <ChatSidebar></ChatSidebar>

    @* Main Chat *@
    <ChatPanel></ChatPanel>

</div>



<!-- Mobile NavBar -->
@if (PlatformHelper.IsMobilePlatform)
{
    <MobileNav></MobileNav>
}



