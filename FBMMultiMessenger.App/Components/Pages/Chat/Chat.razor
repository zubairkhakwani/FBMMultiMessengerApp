@page "/"
@page "/Chat"
@using FBMMultiMessenger.Contracts.Contracts.Chat
@using FBMMultiMessenger.Contracts.Enums

@layout EmptyLayout


@attribute [Authorize(Policy = "ValidSubscription")]

@{
    var mobileView = PlatformHelper.IsMobilePlatform ? "" : "messenger-container";
    var mobileClass = PlatformHelper.IsMobilePlatform ? "mobile" : "";
    var messageContainerHeight = SelectedChatId is null ? "100vh" : "calc(100vh - 135px)";
    var sidebarHeight = PlatformHelper.IsMobilePlatform ? "calc(100vh - 180px)" : "calc(100vh - 125px)";
    var avatarMargin = PlatformHelper.IsMobilePlatform ? "0px" : "12px";
    var hideScrollBar = PlatformHelper.IsMobilePlatform ? "hide-scrollbar" : "";
}


<div class="@mobileView">
    <!-- Sidebar -->

    <div class="sidebar @mobileClass" style="z-index:@SidebarZIndex;">

        @if (!IsChatsLoading)
        {
            <div class="sidebar-header">
                <div style="display:flex;align-items:center;">
                    <NavLink style="padding: 20px 10px 20px 20px;" href="Account">
                        <i class="fa-sharp fa-solid fa-arrow-left"></i>
                    </NavLink>

                    <h2 class="sidebar-title">Marketplace Chat</h2>
                </div>

                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input @bind-value="FilterKeyword"
                           @bind-value:event="oninput" type="text" class="search-input" placeholder="Search conversations">
                </div>
            </div>
        }

        @if (IsChatsLoading)
        {
            <ChatLoadingSkelton></ChatLoadingSkelton>
        }

        else if (FilteredAccountChats?.Any() == true)
        {
            <div class="chat-list @hideScrollBar" style="height:@sidebarHeight">
                @for (int i = 0; i < FilteredAccountChats.Count; i++)
                {
                    var chat = FilteredAccountChats[i];
                    var chatId = chat.ChatId;
                    var fbListingImage = chat.FbListingImage;
                    var fbListingTitle = chat.FbListingTitle;
                    var fbListingLocation = chat.FbListingLocation;
                    var messagePreview = chat.MessagePreview;
                    var senderName = chat.SenderName;
                    var isRead = chat.IsRead ? "read" : "unread";
                    var fbListingPrice = chat.FbListingPrice;
                    var unreadCount = chat.UnReadCount;
                    var hide = (unreadCount == 0 || chat.IsRead) ? "hide" : "";
                    var accountStatus = AccountStatusLoaded ? chat.IsAccountConnected ? "active" : "inactive" : "loading";
                    var chatAccountName = chat.Account?.Name;

                    <div @onclick="() => SyncAndLoadChatMessages(chatId)" class="chat-item unread">

                        <div class="avatar">
                            @if (fbListingImage is null)
                            {
                                <span>Loading</span>
                            }
                            else
                            {
                                <img src="@fbListingImage" alt="product-image" />
                            }
                            <span class="status-indicator @accountStatus"></span>
                            <span class="unread-badge @hide">@unreadCount</span>
                        </div>

                        <div class="chat-info">
                            <div class="chat-name">@fbListingTitle</div>
                            <div class="chat-listing-info @isRead">
                                @if (!string.IsNullOrWhiteSpace(chatAccountName))
                                {
                                    <div class="preview">Account: @chatAccountName</div>
                                }
                                @if (messagePreview is not null)
                                {
                                    <div class="preview">@senderName: @messagePreview</div>
                                }

                                @if (fbListingLocation is not null)
                                {
                                    <div class="listing-location">@fbListingLocation</div>
                                }
                                @if (fbListingPrice is not null)
                                {
                                    <div class="listing-price">$@fbListingPrice</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {

            <div class="empty-state-sidebar">
                <div class="empty-state-icon-sidebar">
                    <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                </div>
                <p>No chats found.</p>
            </div>
        }

    </div>


    <!-- Main Chat Area -->
    <div class="main-chat  @mobileClass" style="z-index:@MainChatZIndex" id="mainChat" @onclick="CloseMessageActionMenu">


        <!--  Chat header for the active conversation. Shows listing image,title,location/price and a back button on mobile for navigation.  -->
        @if (SelectedChatId is not null)
        {
            var accountStatus = IsSelectedChatsAccountConnected ? "active" : "inactive";

            <div class="chat-header-container">
                @if (PlatformHelper.IsMobilePlatform)
                {
                    <div style="cursor:pointer; padding: 33px 12px 32px 20px;" @onclick="ShowSidebarView">
                        <i class="fa-sharp fa-solid fa-arrow-left"></i>
                    </div>
                }
                <div class="chat-header" @onclick="HandleChatMenuOpen">
                    <div class="avatar" style="margin-left:@avatarMargin">
                        <span class="status-indicator @accountStatus"></span>
                        @if (SelectedChatListingImage is not null)
                        {
                            <img src="@SelectedChatListingImage" />
                        }
                        else
                        {
                            <span>Loading</span>
                        }

                    </div>
                    <div class="header-info">

                        @if (SelectedChatListingTitle is not null)
                        {
                            <h3>@SelectedChatListingTitle</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedAccountName))
                        {
                            <p>Account: @SelectedAccountName</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(ChattingWithName))
                        {
                            <p>Chatting With: @ChattingWithName</p>
                        }
                        @if (SelectedChatListingLocation is not null && SelectedChatListingPrice is not null)
                        {
                            <p>@SelectedChatListingLocation - @SelectedChatListingPrice</p>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="messages-container" id="messagesContainer" style="height:@messageContainerHeight">
            <!-- Empty state shown on desktop when no conversation is selected -->
            @if (SelectedChatId is null && !PlatformHelper.IsMobilePlatform)
            {
                <div class="empty-state" id="emptyState">
                    <div class="empty-state-icon">
                        <svg width="60" height="60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                    </div>
                    <h3>Select a conversation</h3>
                    <p>Choose a conversation from the sidebar to start chatting with your Marketplace buyers and sellers.</p>
                </div>
            }

            <div id="messagesList">
                @for (int i = 0; i < ChatMessages.Count; i++)
                {
                    var chatMessage = ChatMessages[i];
                    var message = chatMessage.Message;
                    var messageId = chatMessage.ChatMessageId;
                    var fbMessageReplyId = chatMessage.FbMessageReplyId;
                    var offlineUniqueId = chatMessage.OfflineUniqueId;
                    var fbTimeStamp = chatMessage.FbTimeStamp;
                    var createdAt = chatMessage.CreatedAt;

                    var messageTime = fbTimeStamp is not null
                                      ? DateTimeOffset.FromUnixTimeMilliseconds(fbTimeStamp.Value)
                                        .LocalDateTime
                                        .ToString("hh:mm tt")
                                      : createdAt.ToLocalTime().ToString("hh:mm tt");

                    var messageReplyObj = chatMessage.MessageReply;
                    var replyTo = messageReplyObj?.ReplyTo;
                    var messageReply = messageReplyObj?.Reply;
                    var messageReplyType = messageReplyObj?.Type;
                    var attacments = messageReplyObj?.Attachments ?? new List<MessageReplyFileHttpResponse>();
                    attacments = attacments.Take(1).ToList(); // Facebook displays only the first attachment in a reply, even if multiple exist
                    var isReceived = chatMessage.IsReceived;
                    var messageClass = isReceived ? "received" : "sent";
                    var isSent = !isReceived;
                    var isMessageFailedToSend = !chatMessage.IsSent && isSent;
                    var failedMessageClass = isMessageFailedToSend ? "failed" : "";
                    var scrollToBottom = chatMessage.ScrollToBottom.ToString();
                    var actionMessageKey = !string.IsNullOrWhiteSpace(offlineUniqueId)
                    ? offlineUniqueId
                    : messageId.ToString();

                    <div class="message
                                @messageClass
                                @failedMessageClass"
                         data-scroll-to-bottom="@scrollToBottom"
                         id="@messageId">

                        @if (chatMessage.IsTextMessage || chatMessage.IsAudioMessage)
                        {
                            @if (isReceived)
                            {
                                <div class="message-row">
                                    @if (UserProfileImage is not null)
                                    {
                                        <div class="profile-picture">
                                            <img class="profile-picture" src="@UserProfileImage" />
                                        </div>
                                    }

                                    <div class="message-bubble highlight"
                                         @onpointerdown="() => StartHold(messageId, offlineUniqueId)"
                                         @onpointerup="CancelHold"
                                         @onpointercancel="CancelHold"
                                         @onclick:stopPropagation="true">

                                        @if (messageReplyObj is not null)
                                        {
                                            <div class="replied-message" @onclick="() => ScrollToRepliedMessageAsync(fbMessageReplyId)">
                                                <div class="replied-sender">@replyTo</div>
                                                @if(messageReplyType == MessageReplyType.Text)
                                                {
                                                    <div class="replied-text">@messageReply</div>
                                                }
                                                else if(messageReplyType == MessageReplyType.Image)
                                                {
                                                    @foreach (var item in attacments)
                                                    {
                                                        <img class="reply-image-message" src="@item.Url" />
                                                    }
                                                }
                                                else if(messageReplyType == MessageReplyType.Video)
                                                {
                                                    <div class="replied-text">Replied to video</div>
                                                }
                                                else
                                                { 
                                                    <div class="replied-text">Replied to audio</div>
                                                }

                                            </div>
                                        }
                                        @if (chatMessage.IsAudioMessage)
                                        {
                                            <audio controls>
                                                <source src="@chatMessage.Message" type="audio/mpeg">
                                                Your browser does not support the audio tag.
                                            </audio>
                                        }
                                        else
                                        {
                                            <span class="message-text">@chatMessage.Message</span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="message-bubble highlight"
                                     @onpointerdown="() => StartHold(messageId, offlineUniqueId)"
                                     @onpointerup="CancelHold"
                                     @onpointercancel="CancelHold"
                                     @onclick:stopPropagation="true">

                                    @if (messageReplyObj is not null)
                                    {
                                        <div class="replied-message" @onclick="() => ScrollToRepliedMessageAsync(fbMessageReplyId)">
                                            <div class="replied-sender">@replyTo</div>
                                            @if (messageReplyType == MessageReplyType.Text)
                                            {
                                                <div class="replied-text">@messageReply</div>
                                            }
                                            else if (messageReplyType == MessageReplyType.Image)
                                            {
                                                @foreach (var item in attacments)
                                                {
                                                    <img class="reply-image-message" src="@item.Url" />
                                                }
                                            }
                                            else if (messageReplyType == MessageReplyType.Video)
                                            {
                                                <div class="replied-text">Replied to video</div>
                                            }
                                            else
                                            {
                                                <div class="replied-text">Replied to audio</div>
                                            }

                                        </div>
                                    }
                                    @if (chatMessage.IsAudioMessage)
                                    {
                                        <audio controls>
                                            <source src="@chatMessage.Message" type="audio/mpeg">
                                            Your browser does not support the audio tag.
                                        </audio>
                                    }else{
                                        <span class="message-text">@chatMessage.Message</span>
                                    }
                                   
                                </div>
                            }
                            <div class="message-footer">
                                <span class="message-time">@messageTime</span>
                                @if (isSent)
                                {
                                    @if (chatMessage.Sending && !isMessageFailedToSend)
                                    {
                                        <span class="message-status sending">
                                            <span class="status-icon">⏱</span> Sending...
                                        </span>
                                    }
                                    else if (chatMessage.Sending && isMessageFailedToSend)
                                    {
                                        <span class="message-status failed">
                                            <span class="status-icon">✗</span> Failed
                                        </span>
                                    }

                                    else
                                    {
                                        <span class="message-status sent">
                                            <span class="status-icon">✓</span> Sent
                                        </span>
                                    }
                                }
                            </div>
                        }

                        @if (chatMessage.FileData.Any())
                        {
                            var filesCount = chatMessage.FileData.Count;
                            var imageWidthStyle = "width: " + (filesCount == 1 ? 429 : filesCount == 2 ? 190 : 125) +"px";
                            <div class="message-row @messageClass">
                                @for (int j = 0; j < chatMessage.FileData.Count; j++)
                                {
                                    var file = chatMessage.FileData[j];

                                    if (file.IsEmoji)
                                    {
                                        imageWidthStyle = "width: 48px; height:48px;";
                                    }
                                    else if (file.IsSticker)
                                    {
                                        imageWidthStyle = "width: 96px; height:96px;";
                                    }
                                    @if (isReceived && UserProfileImage is not null && j==0)
                                    {
                                        <div class="profile-picture">
                                            <img class="profile-picture" src="@UserProfileImage" />
                                        </div>
                                    }
                                    //here if we want to add the message bubble class we can
                                    <div class="highlight">
                                        @if (messageReplyObj is not null)
                                        {
                                            <div class="replied-message" @onclick="() => ScrollToRepliedMessageAsync(fbMessageReplyId)">
                                                <div class="replied-sender">@replyTo</div>
                                                @if (messageReplyType == MessageReplyType.Text)
                                                {
                                                    <div class="replied-text">@messageReply</div>
                                                }
                                                else if (messageReplyType == MessageReplyType.Image)
                                                {
                                                    @foreach (var item in attacments)
                                                    {
                                                        <img class="reply-image-message" src="@item.Url" />
                                                    }
                                                }
                                                else if (messageReplyType == MessageReplyType.Video)
                                                {
                                                    <div class="replied-text">Replied to video</div>
                                                }
                                                else
                                                {
                                                    <div class="replied-text">Replied to audio</div>
                                                }

                                            </div>
                                        }

                                          @if (file.IsVideo)
                                    {
                                        <video width="320" height="240" controls>
                                            <source src="@(file.PreviewUrl + "#t=0.001")" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    }
                                    else
                                    {
                                        <img @onclick="() => ShowCarousal(chatMessage.FileData, file.PreviewUrl)"
                                             class="image-message @((file.IsEmoji || file.IsSticker) ? "not-clickable" : "clickable")"
                                             src="@file.PreviewUrl"
                                             style="@imageWidthStyle" />
                                    }
                                    </div>
                                  
                                }
                            </div>

                            <div class="message-footer">
                                <span class="message-time">@messageTime</span>
                                @if (isSent)
                                {
                                    @if (chatMessage.Sending && !isMessageFailedToSend)
                                    {
                                        <span class="message-status sending">
                                            <span class="status-icon">⏱</span> Sending...
                                        </span>
                                    }
                                    else if (chatMessage.Sending && isMessageFailedToSend)
                                    {
                                        <span class="message-status failed">
                                            <span class="status-icon">✗</span> Failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="message-status sent">
                                            <span class="status-icon">✓</span> Sent
                                        </span>
                                    }
                                }
                            </div>
                        }

                        @* Message Actions *@
                        <div class="actions-menu @(ActionsMenuMessageKey == actionMessageKey ? "show" : "")">
                            @if (!string.IsNullOrWhiteSpace(chatMessage.FbMessageId))
                            {
                                @* <span class="action-btn" data-tooltip="Reply" @onclick="() => HandleMessageReply(actionMessageKey, showMessageReply: true)">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M10 9V5l-7 7 7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-10-11-11z" />
                                    </svg>
                                </span> *@
                            }

                            @if (chatMessage.IsTextMessage)
                            {
                                <span class="action-btn" data-tooltip="Copy" @onclick="() => HandleCopyToClipboardAsync(message)">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                    </svg>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="input-wrapper">

            <!--  Media attachment preview. Allows users to review and remove files before sending.  -->
            @if (PreviewMediaFiles.Any())
            {
                <div class="file-preview-container" id="filePreview">
                    <div class="file-preview-grid">

                        @for (int i = 0; i < PreviewMediaFiles.Count; i++)
                        {
                            var file = PreviewMediaFiles[i];

                            <div class="file-preview-item">
                                @if (file.IsVideo)
                                {
                                    <div class="video-indicator">▶️</div>
                                    <video class="preview-media" src="@(file.PreviewUrl + "#t=0.001")"></video>
                                }
                                else
                                {
                                    <img class="preview-media" src="@file.PreviewUrl" alt="@file.Name">
                                }
                                <button class="remove-file-btn" @onclick="() => HandleFileRemoval(file.Id)">✕</button>
                                <div class="file-name">@file.Name</div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (ShowMessageReply)
            {
                <div class="replying-to-banner">
                    <div class="replying-to-content">
                        <div class="replying-to-label">Replying to @MessageReplyTo</div>
                        <div class="replying-to-text">@MessageReply</div>
                    </div>
                    <button class="cancel-reply-btn" @onclick="HandleCancelMessageReply">X</button>
                </div>
            }

            <!--   Chat composer (text, attachments, send).  Rendered only when a conversation is selected. -->
            @if (SelectedChatId is not null)
            {
                <div class="input-container">
                    <InputFile type="file" id="fileInput" accept="image/*,video/*" multiple style="display: none;" onchange="HandleFileUpload" />
                    <label for="fileInput" class="file-upload-btn" title="Attach files">📎</label>
                    <textarea @bind="Message" class="message-input" placeholder="Type a message..." rows="1" autofocus>  </textarea>
                    <button @onclick="() => NotifyLocalServer(Message)" class="send-button" disabled="@isCompressingMedia">➤</button>
                </div>
            }
        </div>
    </div>
</div>


<!-- Carousal -->
@if (ShowCarousel)
{
    <div class="carousel-overlay">
        <MudCarousel Class="mud-width-full" Style="height:100%;" AutoCycle="false" ItemsSource="_carouselItems">

            <BulletTemplate Context="selected">
                <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
                    <span class="mud-icon-button-label">
                        <MudIcon Icon="@(selected? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Color="Color.Primary" />
                    </span>
                </div>
            </BulletTemplate>
            <PreviousButtonTemplate>
                <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
                    <span class="mud-icon-button-label">
                        <MudIcon Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Size="Size.Large" Icon="@Icons.Material.Filled.SkipPrevious" Color="Color.Primary" />
                    </span>
                </div>
            </PreviousButtonTemplate>
            <NextButtonTemplate>
                <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
                    <span class="mud-icon-button-label">
                        <MudIcon Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Size="Size.Large" Icon="@Icons.Material.Filled.SkipNext" Color="Color.Primary" />
                    </span>
                </div>
            </NextButtonTemplate>
            <ItemTemplate>
                <div class="carousel-close-container" @onclick="CloseCarousel">
                    <MudIcon Icon="@Icons.Material.Filled.Close"
                             Color="@Color.Error"
                             Size="@Size.Large"
                             Style="background-color: rgba(0, 0, 0, 0.45);
                                                                                                                                                                                                                padding: 5px;
                                                                                                                                                                                                                border-radius:100px;
                                                                                                                                                                                                                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35)" />
                </div>
                <div class="d-flex flex-column flex-column justify-center align-center" style="height:100%">

                    @if (context.IsVideo)
                    {
                        <video width="320" height="240" controls>
                            <source src="@(context.PreviewUrl + "#t=0.001")" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>
                    }
                    else
                    {
                        <img style="max-width:100%;" src="@context.PreviewUrl" alt="image" />
                    }
                </div>
            </ItemTemplate>
        </MudCarousel>

    </div>
}



@if (ShowChatMenuAction)
{
    <ChatActionMenu ProfileName="@ChattingWithName" ProfileId="@ChattingWithId" ListingId="@CurrentChatListingId" OnClose="HandleChatMenuClose" />
}

<!-- Mobile NavBar -->
@if (PlatformHelper.IsMobilePlatform && SidebarZIndex > MainChatZIndex)
{
    <MobileNav></MobileNav>
}


<div class="arrow-down pulse-animation">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
        <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
</div>



<script src="/Components/Pages/Chat/Chat.razor.js"></script>























