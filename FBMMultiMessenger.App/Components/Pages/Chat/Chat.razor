@page "/"
@page "/Chat"

@layout EmptyLayout


@attribute [Authorize(Policy = "ValidSubscription")]

@{
    var mobileView = PlatformHelper.IsMobilePlatform ? "" : "messenger-container";
    var mobileClass = PlatformHelper.IsMobilePlatform ? "mobile" : "";
    var sideBarHeight = PlatformHelper.IsMobilePlatform ? "auto" : "calc(100vh - 125px)";
    var messageContainerHeight = SelectedFbChatId is null ? "100vh" : "calc(100vh - 135px)";
    var avatarMargin = PlatformHelper.IsMobilePlatform ? "0px" : "12px";
}


<div class="@mobileView">
    <!-- Sidebar -->
    <div class="sidebar @mobileClass" style="z-index:@SidebarZIndex;">

        @if (IsLoading && (FilteredAccountChats?.Count ?? 0) == 0)
        {
            <ChatLoadingSkelton></ChatLoadingSkelton>
        }
        else if (!IsLoading && FilteredAccountChats?.Any() == true)
        {
            <div class="sidebar-header">
                <div style="display:flex;align-items:center;">
                    <NavLink style="padding: 20px 10px 20px 20px;" href="Account">
                        <i class="fa-sharp fa-solid fa-arrow-left"></i>
                    </NavLink>

                    <h2 class="sidebar-title">Marketplace Chat</h2>
                </div>

                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input @bind-value="FilterKeyword"
                           @bind-value:event="oninput" type="text" class="search-input" placeholder="Search conversations">
                </div>
            </div>
            <div class="chat-list" style="height:@sideBarHeight">
                @for (int i = 0; i < FilteredAccountChats.Count; i++)
                {
                    var fbChatId = FilteredAccountChats[i].FbChatId;
                    var chat = FilteredAccountChats[i];
                    var fbListingImage = chat.FbListingImage;
                    var fbListingTitle = chat.FbListingTitle;
                    var fbListingLocation = chat.FbListingLocation;
                    var messagePreview = chat.MessagePreview;
                    var senderName = chat.SenderName;
                    var isRead = chat.IsRead ? "read" : "unread";
                    var fbListingPrice = chat.FbListingPrice;
                    var unreadCount = chat.UnReadCount;
                    var hide = (unreadCount == 0 || chat.IsRead) ? "hide" : "";
                    var accountStatus = chat.IsAccountConnected ? "active" : "inactive";

                    <div @onclick="() => LoadChatMessage(fbChatId)" class="chat-item unread">

                        <div class="avatar">
                            @if (fbListingImage is null)
                            {
                                <span>Loading</span>
                            }
                            else
                            {
                                <img src="@fbListingImage" alt="product-image" />

                            }
                            <span class="status-indicator @accountStatus"></span>
                            <span class="unread-badge @hide">@unreadCount</span>
                        </div>

                        <div class="chat-info">
                            <div class="chat-name">@fbListingTitle</div>
                            <div class="chat-listing-info @isRead">
                                @if (messagePreview is not null)
                                {
                                    <div class="preview">@senderName: @messagePreview</div>
                                }
                                else if (fbListingLocation is not null)
                                {
                                    <div class="listing-location">@fbListingLocation</div>
                                }
                                @if (fbListingPrice is not null)
                                {
                                    <div class="listing-price">$@fbListingPrice</div>
                                }
                            </div>
                        </div>
                        @* <div class="chat-time">2m</div> *@
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sidebar-header">
                <div style="display:flex;align-items:center;">
                    <NavLink style="padding: 20px 10px 20px 20px;" href="Account">
                        <i class="fa-sharp fa-solid fa-arrow-left"></i>
                    </NavLink>

                    <h2 class="sidebar-title">Marketplace Chat</h2>
                </div>

                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input @bind-value="FilterKeyword"
                           @bind-value:event="oninput" type="text" class="search-input" placeholder="Search conversations">
                </div>
            </div>
            <div class="empty-state-sidebar">
                <div class="empty-state-icon-sidebar">
                    <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                </div>
                <p>No chats found.</p>
            </div>
        }

    </div>


    <!-- Main Chat Area -->
    <div class="main-chat  @mobileClass" style="z-index:@MainChatZIndex" id="mainChat">


        <!--  Chat header for the active conversation. Shows listing image, title, location/price,  and a back button on mobile for navigation.  -->
        @if (SelectedFbChatId is not null)
        {
            <div class="chat-header">
                @if (PlatformHelper.IsMobilePlatform)
                {
                    <div style="cursor:pointer; padding: 33px 12px 32px 20px;" @onclick="HandleMobileMainChat">
                        <i class="fa-sharp fa-solid fa-arrow-left"></i>
                    </div>
                }

                <div class="avatar" style="margin-left:@avatarMargin">
                    @if (selectedListingImage is not null)
                    {
                        <img src="@selectedListingImage" />

                    }
                    else
                    {
                        <span>No Image</span>
                    }

                </div>
                <div class="header-info">

                    @if (selectedListingTitle is not null)
                    {
                        <h3>@selectedListingTitle</h3>

                    }
                    @if (selectedListingLocation is not null && selectedListingPrice is not null)
                    {
                        <p>@selectedListingLocation - @selectedListingPrice</p>
                    }

                </div>
            </div>
        }



        <div class="messages-container" id="messagesContainer" style="height:@messageContainerHeight">
            <!-- Empty state shown on desktop when no conversation is selected -->
            @if (SelectedFbChatId is null && !PlatformHelper.IsMobilePlatform)
            {
                <div class="empty-state" id="emptyState">
                    <div class="empty-state-icon">
                        <svg width="60" height="60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                    </div>
                    <h3>Select a conversation</h3>
                    <p>Choose a conversation from the sidebar to start chatting with your Marketplace buyers and sellers.</p>
                </div>
            }



            <div id="messagesList">
                @for (int i = 0; i < ChatMessages.Count; i++)
                {
                    var chatMessage = ChatMessages[i];

                    var isReceived = chatMessage.IsReceived;
                    var messageClass = isReceived ? "received" : "sent";
                    var isSent = !isReceived;
                    var isMessageFailedToSend = !chatMessage.IsSent && isSent;
                    var failedMessageClass = isMessageFailedToSend ? "failed" : "";

                    @if (chatMessage.IsTextMessage || chatMessage.IsAudioMessage)
                    {
                        <div class="message @messageClass @failedMessageClass">
                            @if (isReceived)
                            {
                                <div class="message-row">
                                    @if (UserProfileImage is not null)
                                    {
                                        <div class="profile-picture">
                                            <img class="profile-picture" src="@UserProfileImage" />
                                        </div>
                                    }

                                    <div class="message-bubble">
                                        @if (chatMessage.IsAudioMessage)
                                        {
                                            <audio controls>
                                                <source src="@chatMessage.Message" type="audio/mpeg">
                                                Your browser does not support the audio tag.
                                            </audio>
                                        }
                                        else
                                        {
                                            <span>@chatMessage.Message</span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="message-bubble">
                                    <span>@chatMessage.Message</span>
                                </div>
                            }


                            <div class="message-footer">
                                <span class="message-time">@chatMessage.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                                @if (isSent)
                                {
                                    @if (chatMessage.Sending)
                                    {
                                        <span class="message-status sending">
                                            <span class="status-icon">⏱</span> Sending...
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="message-status sent">
                                            <span class="status-icon">✓</span> Sent
                                        </span>
                                    }
                                }

                            </div>
                        </div>
                    }

                    @if (chatMessage.FileData.Any())
                    {
                        var filesCount = chatMessage.FileData.Count;
                        var imageWidthStyle = "width: " + (filesCount == 1 ? 429 : filesCount == 2 ? 190 : 125) +"px";

                        <div class="message @messageClass">
                            <div class="message-row @messageClass">
                                @for (int j = 0; j < chatMessage.FileData.Count; j++)
                                {
                                    var file = chatMessage.FileData[j];
                                    @if (isReceived && UserProfileImage is not null && j==0)
                                    {
                                        <div class="profile-picture">
                                            <img class="profile-picture" src="@UserProfileImage" />
                                        </div>
                                    }
                                    @if (file.IsVideo)
                                    {
                                        <video width="320" height="240" controls>
                                            <source src="@file.FileUrl" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    }
                                    else
                                    {
                                        <img @onclick="() => ShowCarousal(chatMessage.FileData, file.FileUrl)" class="image-message" src="@file.FileUrl" style="@imageWidthStyle" />
                                    }
                                }
                            </div>
                            <div class="message-footer">
                                <span class="message-time">@chatMessage.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                                @if (isSent)
                                {
                                    @if (chatMessage.Sending)
                                    {
                                        <span class="message-status sending">
                                            <span class="status-icon">⏱</span> Sending...
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="message-status sent">
                                            <span class="status-icon">✓</span> Sent
                                        </span>
                                    }
                                }

                            </div>

                        </div>
                    }
                }
            </div>
        </div>

        <div class="input-wrapper">

            <!--  Media attachment preview. Allows users to review and remove files before sending.  -->
            @if (PreviewMediaFiles.Any())
            {
                <div class="file-preview-container" id="filePreview">
                    <div class="file-preview-grid">

                        @for (int i = 0; i < PreviewMediaFiles.Count; i++)
                        {
                            var file = PreviewMediaFiles[i];

                            <div class="file-preview-item">
                                <img class="preview-media" src="@file.FileUrl" alt="@file.FileName">
                                @if (file.IsVideo)
                                {
                                    <div class="video-indicator">▶️</div>
                                }
                                <button class="remove-file-btn" @onclick="() => HandleFileRemoval(file.Id)">✕</button>
                                <div class="file-name">@file.FileName</div>
                            </div>
                        }
                    </div>
                </div>
            }



            <!--   Chat composer (text, attachments, send).  Rendered only when a conversation is selected. -->
            @if (SelectedFbChatId is not null)
            {
                <div class="input-container">
                    <InputFile type="file" id="fileInput" accept="image/*,video/*" multiple style="display: none;" onchange="HandleFileUpload" />
                    <label for="fileInput" class="file-upload-btn" title="Attach files">📎</label>
                    <textarea @bind="Message" class="message-input" placeholder="Type a message..." rows="1" onblur="this.focus()" autofocus>  </textarea>
                    <button @onclick="() => NotifyLocalServer(Message)" class="send-button">➤</button>
                </div>
            }

        </div>
    </div>
</div>


<!-- Carousal -->
@if (_showCarousel)
{
    <div class="carousel-overlay">
        <div class="carousel-close-container" @onclick="CloseCarousel">
            <MudIcon Icon="@Icons.Material.Filled.Close"
                     Color="@Color.Error"
                     Size="@Size.Large" />
        </div>
        <MudCarousel ItemsSource="@_carouselItems" NavigationButtonsClass="navigation-btns" Class="mud-width-full" Style="height:100vh;" AutoCycle="false">
            <BulletTemplate Context="selected">
                <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
                    <span class="mud-icon-button-label">
                        <MudIcon Icon="@(selected? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Color="@Color.Inherit" />
                    </span>
                </div>
            </BulletTemplate>
            <PreviousButtonTemplate>
                <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
                    <span class="mud-icon-button-label">
                        <MudIcon Icon="@Icons.Material.Filled.SkipPrevious"
                                 Size="Size.Large"
                                 Color="Color.Inherit" />
                    </span>
                </div>
            </PreviousButtonTemplate>
            <NextButtonTemplate>
                <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
                    <span class="mud-icon-button-label">
                        <MudIcon Icon="@Icons.Material.Filled.SkipNext" Size="Size.Large" Color="@Color.Inherit" />
                    </span>
                </div>
            </NextButtonTemplate>
            <ItemTemplate>

                <div style="display:flex; justify-content:center;align-items:center;">
                    @if (context.IsVideo)
                    {
                        <video width="450" height="340" controls>
                            <source src="@context.FileUrl" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>
                    }
                    else
                    {
                        <img src="@context.FileUrl" alt="Image" />
                    }
                </div>
            </ItemTemplate>
        </MudCarousel>
    </div>
}



@* Mobile Nav *@







@* Mobile Nav *@





<!-- Mobile NavBar -->
@if (PlatformHelper.IsMobilePlatform && SidebarZIndex > MainChatZIndex)
{
    <MobileNav></MobileNav>
}



<script src="/Components/Pages/Chat/Chat.razor.js"></script>
