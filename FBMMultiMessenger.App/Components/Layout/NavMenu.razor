 <div class="sidebar-container">
        <div class="sidebar">
            <div class="brand">
                <div class="brand-left">
                    <div class="brand-icon">
                        <svg width="60" height="60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                    </div>
                    <h1>FbmMultiMessenger</h1>

                    <div class="sidebar_toggler">
                        <span class="sidebar_toggler-bar"></span>
                        <span class="sidebar_toggler-bar"></span>
                        <span class="sidebar_toggler-bar"></span>
                    </div>
                </div>
            </div>
            <div class="custom-nav">
                <div class="slideable">
                    <NavLink href="/Account" Match="NavLinkMatch.All" class="nav-link">
                        <i class="fa fa-id-badge"></i>
                        <span>Accounts</span>
                    </NavLink>
                </div>

                <div class="slideable">
                    <NavLink href="/Chat" Match="NavLinkMatch.All" class="nav-link slideable">
                        <i class="fas fa-message"></i>
                        <span>Chats</span>
                    </NavLink>
                </div>

                <div class="slideable">

                    <NavLink href="/Default-Messages" class="nav-link slideable">
                        <i class="fa fa-comments"></i>
                        <span>Default Messages</span>
                    </NavLink>
                </div>


                <div class="section-title slideable">Settings</div>

                <div class="slideable">
                    <NavLink href="/profile" class="nav-link">
                        <i class="fas fa-cog"></i>
                        <span>Profile</span>
                    </NavLink>
                </div>
                
                <div class="nav-link slideable" @onclick="Logout">
                    <i class="fa fa-sign-out-alt"></i>
                    <span>Logout</span>
                </div>
            </div>
        </div>
    </div>

<script>
     var toggler = document.querySelector(".sidebar_toggler");
     var nav = document.querySelector(".custom-nav");
     var navLinks = document.querySelectorAll('.slideable');
     var body = document.querySelector("body");


    toggler.addEventListener("click", function () {
         if (nav && navLinks) {
             console.log(navLinks);
             navLinks.forEach((navLink)=>{
                 navLink.classList.toggle("hide");
             });
             console.log(body);
             body.classList.toggle("toggle-overflow");
             nav.classList.toggle("hide");
         }
     });
</script>

