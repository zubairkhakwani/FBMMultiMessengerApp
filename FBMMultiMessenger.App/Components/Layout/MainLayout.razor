@inherits LayoutComponentBase


<FBMMultiMessenger.Components.Shared.CustomErrorBoundary>

    <div class="page">

        @if (!PlatformHelper.IsMobilePlatform)
        {
            <div class="sidebar">
                <NavMenu />
            </div>
        }
        <main>

            @if (PlatformHelper.IsMobilePlatform)
            {
                <MobileNav></MobileNav>
            }
            else
            {
               <TopBar></TopBar>
            }

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>


</FBMMultiMessenger.Components.Shared.CustomErrorBoundary> 