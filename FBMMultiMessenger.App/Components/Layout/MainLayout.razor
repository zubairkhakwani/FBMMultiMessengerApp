@inherits LayoutComponentBase


<FBMMultiMessenger.Components.Shared.CustomErrorBoundary>

    <div class="page">

        <div class="sidebar">
            <NavMenu />
        </div>
        <main>

            @if (isMobilePlatform)
            {
                <MobileNav></MobileNav>
            }
            else
            {
                    <TopBar></TopBar>
            }

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>


</FBMMultiMessenger.Components.Shared.CustomErrorBoundary> 